feature -- Access

	token_name (a_token: INTEGER): STRING
			-- Name of token `a_token'
		do
			inspect a_token
			when 0 then
				Result := "EOF token"
			when -1 then
				Result := "Error token"
			when NUMBER then
				Result := "NUMBER"
			when NAME then
				Result := "NAME"
			when SQRT then
				Result := "SQRT"
			when SQUARED then
				Result := "SQUARED"
			else
				Result := yy_character_token_name (a_token)
			end
		end

