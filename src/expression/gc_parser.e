			-- (terminal and nonterminal)

feature -- User-defined features



feature {NONE} -- Initialization

	make
			-- A parser with no expression yet.
		do
			make_skeleton
			create input.make_empty
			create last_string_32_value.make_empty
		ensure
			nothing_parsed: last_node = Void
		end

feature -- Parsing

	parse_text (a_text: READABLE_STRING_GENERAL)
			-- Parse `a_text' into `last_node', or set `error_message'.
		do
			input := a_text.to_string_32
			position := 1
			last_node := Void
			variable_name := Void
			error_message := Void
			error_position := 0
			parse
			if error_message = Void and last_node = Void then
				error_message := {STRING_32} "empty expression"
			end
			if attached error_message then
				last_node := Void
			end
		ensure
			one_outcome: (last_node /= Void) xor (error_message /= Void)
		end

feature -- Access

	last_node: detachable GC_NODE
			-- The expression from the last `parse_text', if it parsed.

	variable_name: detachable STRING_32
			-- The expression's variable, if it has one.

	error_message: detachable STRING_32
			-- Why the last `parse_text' failed.

	error_position: INTEGER
			-- Character position of the failure (1-based).

	is_parsed: BOOLEAN
		do
			Result := last_node /= Void
		end

feature {NONE} -- Semantic helpers

	named (a_name: STRING_32): GC_NODE
			-- A constant, or the variable `a_name'.
		do
			if (a_name.count = 1 and then a_name.item (1) = '%/960/') or a_name.same_string ({STRING_32} "pi") then
				create {GC_NUMBER} Result.make ({SIMPLE_MATH}.pi)
			elseif a_name.same_string ({STRING_32} "e") then
				create {GC_NUMBER} Result.make ({SIMPLE_MATH}.e)
			else
				if attached variable_name as al_name and then not al_name.same_string (a_name) then
					fail ({STRING_32} "two variables: " + al_name + {STRING_32} " and " + a_name)
				else
					variable_name := a_name
				end
				create {GC_VARIABLE} Result.make (a_name)
			end
		end

	applied (a_name: STRING_32; an_argument: GC_NODE): GC_NODE
			-- `a_name' applied to `an_argument', or `a_name' times it when `a_name' is no function.
		do
			if (create {GC_CALL}.make ({STRING_32} "abs", an_argument)).is_function (a_name) then
				create {GC_CALL} Result.make (a_name, an_argument)
			else
				create {GC_BINARY} Result.make ('*', named (a_name), an_argument)
			end
		end

	fail (a_message: STRING_32)
			-- Stop with `a_message'.
		do
			if error_message = Void then
				error_message := a_message
				error_position := token_start
			end
			abort
		end

	report_error (a_message: STRING)
			-- Record a syntax error.
		do
			if error_message = Void then
				if token_start > input.count then
					error_message := {STRING_32} "unexpected end of expression"
				else
					error_message := {STRING_32} "unexpected '" + input.item (token_start).out + {STRING_32} "'"
				end
				error_position := token_start
			end
		end

feature {NONE} -- Scanner

	input: STRING_32
	position: INTEGER
	token_start: INTEGER

	last_token: INTEGER
			-- The last token read.

	read_token
			-- Read the next token from `input'.
		local
			c: CHARACTER_32
			l_text: STRING_32
		do
			from
			until
				position > input.count or else not input.item (position).is_space
			loop
				position := position + 1
			end
			token_start := position
			if position > input.count then
				last_token := 0
			else
				c := input.item (position)
				if c.is_digit or (c = '.' and position < input.count and then input.item (position + 1).is_digit) then
					create l_text.make (8)
					from
					until
						position > input.count or else not (input.item (position).is_digit or input.item (position) = '.')
					loop
						l_text.extend (input.item (position))
						position := position + 1
					end
					if l_text.is_real_64 then
						last_real_64_value := l_text.to_real_64
						last_token := NUMBER
					else
						last_token := ('?').code
					end
				elseif is_name_character (c) then
					create l_text.make (8)
					from
					until
						position > input.count or else not (is_name_character (input.item (position)) or input.item (position).is_digit)
					loop
						l_text.extend (input.item (position))
						position := position + 1
					end
					last_string_32_value := l_text
					last_token := NAME
				else
					position := position + 1
					if c = '%/8730/' then
						last_token := SQRT
					elseif c = '%/178/' then
						last_token := SQUARED
					elseif c = '%/183/' or c = '%/215/' then
						last_token := ('*').code
					elseif c = '%/8722/' then
						last_token := ('-').code
					elseif c = '+' or c = '-' or c = '*' or c = '/' or c = '^' or c = '(' or c = ')' then
						last_token := c.code
					else
						last_token := ('?').code
					end
				end
			end
		end

	is_name_character (c: CHARACTER_32): BOOLEAN
			-- Can `c' start or continue a name? Letters of any script (Greek included), and _.
		do
			Result := c.is_alpha or c = '_'
		end

end
